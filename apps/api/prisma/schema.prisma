generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  MARKETING
  VIEWER
}
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  BOOKED
  WON
  LOST
}
enum CampaignStatus {
  DRAFT
  SCHEDULED
  PAUSED
  COMPLETED
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  passwordHash String
  enabled Boolean @default(true)
  role Role @default(SALES_EXECUTIVE)
  createdAt DateTime @default(now())
  assignedLeads Lead[]
  sessions Session[]
  activities LeadActivity[]
  reminders Reminder[]
  outboundMessages OutboundMessage[]
  consents LeadConsent[]
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  csrfToken String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Project {
  id String @id @default(uuid())
  name String
  slug String @unique
  location String?
  description String?
  layoutData String?
  status String @default("PLANNING")
  plots Plot[]
  leads Lead[]
  websiteForms WebsiteForm[]
}
model Plot {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  label String
  row Int
  column Int
  area String?
  areaSqFeet String?
  north String?
  south String?
  east String?
  west String?
  boundary Json?
  status String @default("AVAILABLE")
  bookings PlotBooking[]
  @@unique([projectId,label])
  @@unique([projectId,row,column])
  @@index([projectId,status])
}
model PlotBooking {
  id String @id @default(uuid())
  plotId String
  plot Plot @relation(fields:[plotId],references:[id],onDelete:Restrict)
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Restrict)
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([plotId,createdAt])
  @@index([leadId])
}
model WebsiteForm {
  id String @id @default(uuid())
  name String
  enabled Boolean @default(true)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  leads Lead[]
  @@index([projectId])
}
model Lead {
  id String @id @default(uuid())
  name String
  phone String
  email String?
  source String @default("manual")
  status LeadStatus @default(NEW)
  message String?
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  websiteFormId String?
  websiteForm WebsiteForm? @relation(fields: [websiteFormId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo User? @relation(fields: [assignedToId], references: [id])
  externalId String? @unique
  utmSource String?
  utmCampaign String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([phone])
  @@index([websiteFormId])
  @@index([status,createdAt])
  activities LeadActivity[]
  reminders Reminder[]
  outboundMessages OutboundMessage[]
  consents LeadConsent[]
  enquiries LeadEnquiry[]
  campaignRecipients CampaignRecipient[]
  bookings PlotBooking[]
}
model LeadEnquiry {
  id String @id @default(uuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  externalId String? @unique
  name String
  phone String
  email String?
  source String
  message String?
  projectId String?
  websiteFormId String?
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model LeadActivity {
  id String @id @default(uuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  kind String
  body String
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model Reminder {
  id String @id @default(uuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  title String
  dueAt DateTime
  completedAt DateTime?
  emailNotify Boolean @default(false)
  emailStatus String @default("PENDING")
  emailError String?
  createdAt DateTime @default(now())
  @@index([userId,completedAt,dueAt])
  @@index([emailNotify,emailStatus,dueAt])
}
model OutboundMessage {
  id String @id @default(uuid())
  requestId String @unique
  fingerprint String
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id])
  channel String
  subject String?
  body String
  recipient String
  status String @default("SENDING")
  providerId String? @unique
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campaignRecipient CampaignRecipient?
  @@index([leadId,createdAt])
}
model LeadConsent {
  id String @id @default(uuid())
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Cascade)
  userId String
  user User @relation(fields:[userId],references:[id])
  optedIn Boolean
  evidence String
  createdAt DateTime @default(now())
  @@index([leadId,createdAt])
}
model Campaign {
  id String @id @default(uuid())
  name String
  templateName String
  status CampaignStatus @default(DRAFT)
  audience String @default("all")
  templateId String?
  templateBody String?
  templateLanguage String?
  parameters Json?
  startedById String?
  recipients CampaignRecipient[]
  createdAt DateTime @default(now())
}
model CampaignRecipient {
  id String @id @default(uuid())
  campaignId String
  campaign Campaign @relation(fields:[campaignId],references:[id],onDelete:Cascade)
  leadId String
  lead Lead @relation(fields:[leadId],references:[id],onDelete:Restrict)
  status String @default("PENDING")
  error String?
  claimedAt DateTime?
  outboundMessageId String? @unique
  outboundMessage OutboundMessage? @relation(fields:[outboundMessageId],references:[id],onDelete:SetNull)
  @@unique([campaignId,leadId])
  @@index([campaignId,status])
}
model CampaignTemplateDraft {
  id String @id @default(uuid())
  name String
  language String
  body String
  parameterCount Int
  createdAt DateTime @default(now())
  @@index([name,language])
}
model WebhookEvent {
  id String @id @default(uuid())
  provider String
  externalId String
  receivedAt DateTime @default(now())
  payload Json?
  processedAt DateTime?
  @@unique([provider,externalId])
}
